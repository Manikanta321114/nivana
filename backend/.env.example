# ==============================================================================
# NIVASA Backend Environment Variables (Example Template)
# ==============================================================================
# Copy this file to .env in the backend folder:
# cp .env.example .env
#
# IMPORTANT: Never commit your actual .env file with real secrets to version control.
# ==============================================================================

# Application Settings
PROJECT_NAME="NIVASA API"
VERSION="0.1.0"
ENVIRONMENT="development"
PORT=8000

# CORS Configuration
# Allowed origins for the frontend. For Vite dev server, this is http://localhost:5173
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Database Configuration (Placeholder - Do NOT connect to Supabase yet)
# Standard PostgreSQL URI format with psycopg driver:
DATABASE_URL="postgresql+psycopg://postgres:your_db_password@your_supabase_host:5432/postgres"

# Authentication & Security Placeholders
# Generate a secure key for production using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="placeholder-secret-key-change-this-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Supabase External Service Placeholders (Deferred for future integration)
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key-placeholder"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key-placeholder"
